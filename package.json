{
  "name": "packman",
  "version": "1.0.0",
  "description": "A tribute recreation of the 1980 Namco Pac-Man arcade game, running in the browser",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "serve": "python3 -m http.server 8123",
    "gfx": "node tools/dump-gfx.mjs gfx.png",
    "audio": "node tools/dump-audio.mjs sounds.wav",
    "shots": "node tools/shots.mjs shots"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
